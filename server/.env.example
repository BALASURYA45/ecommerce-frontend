PORT=8787

# Optional: set allowed origins for CORS (comma-separated). If empty, same-origin only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# Admin claim setter (Firebase Admin SDK)
# 1) Create a Firebase service account JSON (Project settings → Service accounts)
# 2) Either set the absolute path:
# FIREBASE_SERVICE_ACCOUNT_JSON=C:\\path\\to\\serviceAccount.json
# OR set a base64-encoded JSON string:
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
#
# Protect the admin endpoints with a shared secret token:
ADMIN_API_TOKEN=change_me
